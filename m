habet alphabet)
 		return "spanish";
 	case SMS_ALPHABET_PORTUGUESE:
 		return "portuguese";
+	case SMS_ALPHABET_BENGALI:
+		return "bengali";
+	case SMS_ALPHABET_GUJARATI:
+                return "gujarati";
 	case SMS_ALPHABET_DEFAULT:
 		return "default";
 	}
@@ -188,6 +192,10 @@ static gboolean sms_alphabet_from_string(const char *s=
tr,
 		*alphabet =3D SMS_ALPHABET_SPANISH;
 	else if (g_str_equal(str, "portuguese"))
 		*alphabet =3D SMS_ALPHABET_PORTUGUESE;
+	else if (g_str_equal(str, "bengali"))
+                *alphabet =3D SMS_ALPHABET_BENGALI;
+	else if (g_str_equal(str, "gujarati"))
+                *alphabet =3D SMS_ALPHABET_GUJARATI;
 	else
 		return FALSE;
