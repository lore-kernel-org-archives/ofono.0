-
-	DBG("%p", modem);
-
-	g_at_chat_unref(data->info.chat);
-	data->info.chat = NULL;
-
-	if (data->agent_registered) {
-		status = bluetooth_send_with_reply(data->handsfree_path,
-					BLUEZ_GATEWAY_INTERFACE, "Disconnect",
-					&data->call, hfp_power_down,
-					modem, NULL,
-					DBUS_TIMEOUT, DBUS_TYPE_INVALID);
-
-		if (status < 0)
-			return -EINVAL;
-	}
-
-	return -EINPROGRESS;
