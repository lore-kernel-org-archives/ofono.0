> +
> +			uint16 TimingAdvance (gsm only)
> +				range 0 - 63
> +
> +			uint16 BcchArfcn (gsm only)
> +				range 0 - 1023
> +
> +			uint16 Bsic (gsm only)
> +				range 0 - 64
