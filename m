> @@ -116,7 +116,7 @@ static void ctm_query_enabled_callback(const struct o=
fono_error *error,
> =C2=A0 =C2=A0 =C2=A0 =C2=A0if (error->type !=3D OFONO_ERROR_TYPE_NO_ERROR=
) {
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0DBusMessage *reply;
>
> - =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 DBG("Error during ctm =
enabled query");
> + =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 ofono_error("Error dur=
ing ctm enabled query");
