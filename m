 /* Defined in TS 102.223 Section 8.13 */
-static void check_gsm_sms_tpdu(const struct sms *command,
-					const struct sms *test)
+static void check_gsm_sms(const struct sms *command,
+					const struct sms_test *test)
 {
-	g_assert(command->submit.mr =3D=3D test->submit.mr);
-	g_assert(command->submit.udl =3D=3D test->submit.udl);
-	check_common_text(command->submit.daddr.address,
-					test->submit.daddr.address);
-	g_assert(g_mem_equal(command->submit.ud, test->submit.ud,
-					test->submit.udl));
+	switch (test->type) {
+	case SMS_TYPE_SUBMIT: {
+		const struct sms_submit *cs =3D &command->submit;
+		const struct sms_submit_test *ts =3D &test->submit;
+		enum sms_charset charset;
+
+		g_assert(cs->rd =3D=3D ts->rd);
+		g_assert(cs->vpf =3D=3D ts->vpf);
+		g_assert(cs->rp =3D=3D ts->rp);
+		g_assert(cs->udhi =3D=3D ts->udhi);
+		g_assert(cs->srr =3D=3D ts->srr);
+		g_assert(cs->mr =3D=3D ts->mr);
+
+		g_assert(cs->daddr.number_type =3D=3D cs->daddr.number_type);
+		g_assert(cs->daddr.numbering_plan =3D=3D cs->daddr.numbering_plan);
+		g_assert(g_str_equal(cs->daddr.address, ts->daddr.address));
+
+		g_assert(cs->pid =3D=3D ts->pid);
+		g_assert(cs->dcs =3D=3D ts->dcs);
+
+		switch (ts->vpf) {
+		case SMS_VALIDITY_PERIOD_FORMAT_RELATIVE:
+			g_assert(cs->vp.relative =3D=3D ts->vp.relative);
+			break;
+		case SMS_VALIDITY_PERIOD_FORMAT_ABSOLUTE: {
+			const struct sms_scts *ca =3D &cs->vp.absolute;
+			const struct sms_scts *ta =3D &ts->vp.absolute;
+			g_assert(ca->year =3D=3D ta->year);
+			g_assert(ca->month =3D=3D ta->month);
+			g_assert(ca->day =3D=3D ta->day);
+			g_assert(ca->hour =3D=3D ta->hour);
+			g_assert(ca->minute =3D=3D ta->minute);
+			g_assert(ca->second =3D=3D ta->second);
+			g_assert(ca->timezone =3D=3D ta->timezone);
+			break;
+		}
+		case SMS_VALIDITY_PERIOD_FORMAT_ENHANCED:
+			g_assert(g_mem_equal(cs->vp.enhanced,
+							ts->vp.enhanced, 7));
+			break;
+		default:
+			break;
+		}
+
+		g_assert(cs->udl =3D=3D ts->udl);
+
+		sms_dcs_decode(ts->dcs, NULL, &charset, NULL, NULL);
+
+		if (charset =3D=3D SMS_CHARSET_8BIT)
+			g_assert(g_str_equal(cs->ud, ts->ud));
+		else {
+			GSList *sms_list =3D NULL;
+			char *message;
+			sms_list =3D g_slist_prepend(sms_list, (void *)command);
+			message =3D sms_decode_text(sms_list);
+			g_assert(g_str_equal(message, ts->ud));
+			g_free(message);
+		}
+
+		break;
+	}
+	default:
+		g_assert(FALSE);
+	}
 }
