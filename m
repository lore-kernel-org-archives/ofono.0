-		g_free(server);
-		return NULL;
-	}
-
-	bluetooth_ref();
-
-	if (sdp_record != NULL)
-		server->sdp_record = g_strdup(sdp_record);
-
-	server->connect_cb = cb;
-	server->user_data = user_data;
-
-	server_list = g_slist_prepend(server_list, server);
