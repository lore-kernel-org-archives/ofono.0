Hi Denis,

I managed to handle the garbage adding a new syntax which is the copy/paste
of gsm_permissive plus a new state.
Here is how the new feed looks:

static GAtSyntaxResult gsm_telit_feed(GAtSyntax *syntax,  const char
*bytes, gsize *len)
{
gsize i =3D 0;
GAtSyntaxResult res =3D G_AT_SYNTAX_RESULT_UNSURE;

while (i < *len) {
char byte =3D bytes[i];

switch (syntax->state) {
case GSM_TELIT_STATE_IDLE:
if (byte =3D=3D '\r' || byte =3D=3D '\n')
/* ignore */;
else if (byte =3D=3D '>')
syntax->state =3D GSM_TELIT_STATE_PROMPT;
else if (byte =3D=3D '~')
syntax->state =3D GSM_TELIT_STATE_GARBAGE;
else if (byte =3D=3D '"')
syntax->state =3D GSM_TELIT_STATE_RESPONSE_STRING;
else
syntax->state =3D GSM_TELIT_STATE_RESPONSE;
break;

case GSM_TELIT_STATE_RESPONSE:
if (byte =3D=3D '\r') {
syntax->state =3D GSM_TELIT_STATE_IDLE;

i +=3D 1;
res =3D G_AT_SYNTAX_RESULT_LINE;
goto out;
} else if (byte =3D=3D '"')
syntax->state =3D
GSM_TELIT_STATE_RESPONSE_STRING;
break;

case GSM_TELIT_STATE_RESPONSE_STRING:
if (byte =3D=3D '"')
syntax->state =3D GSM_TELIT_STATE_RESPONSE;
break;

case GSM_TELIT_STATE_GUESS_PDU:
if (byte !=3D '\r' && byte !=3D '\n')
syntax->state =3D GSM_TELIT_STATE_PDU;
break;

case GSM_TELIT_STATE_PDU:
if (byte =3D=3D '\r') {
syntax->state =3D GSM_TELIT_STATE_IDLE;

i +=3D 1;
res =3D G_AT_SYNTAX_RESULT_PDU;
goto out;
}
break;

case GSM_TELIT_STATE_PROMPT:
if (byte =3D=3D ' ') {
syntax->state =3D GSM_TELIT_STATE_IDLE;
i +=3D 1;
res =3D G_AT_SYNTAX_RESULT_PROMPT;
goto out;
}

syntax->state =3D GSM_TELIT_STATE_RESPONSE;
return G_AT_SYNTAX_RESULT_UNSURE;

case GSM_TELIT_STATE_GUESS_SHORT_PROMPT:
if (byte =3D=3D '\n')
/* ignore */;
else if (byte =3D=3D '\r')
syntax->state =3D GSM_TELIT_STATE_SHORT_PROMPT;
else
syntax->state =3D GSM_TELIT_STATE_RESPONSE;
break;

case GSM_TELIT_STATE_SHORT_PROMPT:
if (byte =3D=3D '\n') {
syntax->state =3D GSM_TELIT_STATE_IDLE;
i +=3D 1;
res =3D G_AT_SYNTAX_RESULT_PROMPT;
goto out;
}

syntax->state =3D GSM_TELIT_STATE_RESPONSE;
return G_AT_SYNTAX_RESULT_UNSURE;


case GSM_TELIT_STATE_GARBAGE:
if (byte =3D=3D '~')
syntax->state =3D GSM_TELIT_STATE_RESPONSE;
break;

default:
break;
};

i +=3D 1;
}

out:
*len =3D i;
return res;
}

Enrico

