Automake >=3D 1.13 enables parallel-tests option which uses a test-driver
script (copied by automake). Ignore this file.

This test-driver script redirects the logs to *.log and *.trs for each
test binary/script so ignore them as well.
---
 .gitignore | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/.gitignore b/.gitignore
index 832c717..65802f4 100644
--- a/.gitignore
+++ b/.gitignore
@@ -23,11 +23,16 @@ ltmain.sh
 missing
 stamp-h1
 autom4te.cache
+test-driver
+test-suite.log
 =

 src/builtin.h
 src/mmsd
 =

 unit/test-wsputil
 unit/test-mmsutil
+unit/test-*.log
+unit/test-*.trs
+
 tools/decode-mms
 tools/create-hex-array
-- =

1.8.3.3


