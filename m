#define TELIT_PRODUCT_LE920A4_1214        0x1214

static const struct option_blacklist_info telit_le910_blacklist =3D {
    .sendsetup =3D BIT(0),
    .reserved =3D BIT(1) | BIT(2),
};

static const struct option_blacklist_info telit_le920_blacklist =3D {
    .sendsetup =3D BIT(0),
    .reserved =3D BIT(1) | BIT(5),
};

static const struct option_blacklist_info telit_le920a4_blacklist_1 =3D {
    .sendsetup =3D BIT(0),
    .reserved =3D BIT(1),
};

But there's no mode 0x1201 for the LE920A4.  So since I'm using mode
0x1201 is it supposed to be treated as an LE910 and use
le910_blacklist?  My other thought is if I need to remove other
drivers from my kernel build.  Does the below output from lsmod mean
that both usbnet and cdc_wdm are using qmi_wwan and causing a conflict
