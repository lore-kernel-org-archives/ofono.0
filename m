RFACE_NUM}=3D=3D"01", ENV{OFONO_LABEL}=3D"aux"
+
+ATTRS{idVendor}=3D=3D"2020", ATTRS{idProduct}=3D=3D"1008", ENV{ID_USB_INTE=
