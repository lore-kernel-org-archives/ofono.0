 4 files changed, 1885 insertions(+), 2 deletions(-)

diff --git a/src/smsutil.c b/src/smsutil.c
index dfa838d..90f158b 100644
--- a/src/smsutil.c
+++ b/src/smsutil.c
@@ -2280,10 +2280,10 @@ char *sms_decode_text(GSList *sms_list)
